# Ignore composer dynamic files generated on deployment servers
vendor/composer/installed.php
vendor/composer/installed.json
vendor/composer/autoload_real.php

# Security & Data Privacy Act (RA 10173): Ignore raw Excel files, SQL dumps, Word documents & sensitive datasets
admin/data/*.xlsx
admin/data/*.xls
admin/data/*.csv
admin/data/*.sql
admin/data/*.docx
admin/data/*.json
admin/data/temp_*
# Ignore runtime generated user uploads (letters, PDFs, appeals, avatars)
uploads/*
!uploads/.htaccess
